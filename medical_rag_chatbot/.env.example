# Copy this file to .env and fill in your values
# cp .env.example .env

# --- LLM API Keys (add at least one) ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# --- Model selection ---
# Options: "gpt-4o", "gpt-4o-mini", "gemini-pro"
LLM_MODEL=gpt-4o-mini

# --- Vector Store ---
VECTOR_STORE_PATH=./embeddings/faiss.index
CHUNKS_PATH=./embeddings/chunks.json

# --- Retrieval settings ---
TOP_K=5
SCORE_THRESHOLD=0.40

# --- Data paths (optional, for re-ingestion) ---
MEDQUAD_PATH=./data/medquad/
DRUGBANK_CSV_PATH=./data/drugbank.csv
